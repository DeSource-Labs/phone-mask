{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "references": [
    { "path": "./packages/phone-mask/tsconfig.json" },
    { "path": "./packages/phone-mask-vue/tsconfig.json" },
    { "path": "./packages/phone-mask-nuxt/tsconfig.json" },
    { "path": "./packages/phone-mask-react/tsconfig.json" },
    { "path": "./packages/phone-mask-svelte/tsconfig.json" }
  ],
  "include": [],
  "exclude": ["node_modules", "dist"]
}
