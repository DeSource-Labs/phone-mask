{
  "name": "@desource/phone-mask-vue",
  "version": "1.7.0",
  "description": "🔌 Vue 3 component, composable, and directive for international phone number masking. Powered by @desource/phone-mask with Google libphonenumber sync.",
  "keywords": [
    "vue",
    "vue3",
    "ssr",
    "phone",
    "mask",
    "input",
    "component",
    "directive",
    "international",
    "libphonenumber",
    "country-code",
    "phone-number",
    "formatting",
    "validation",
    "composition-api",
    "typescript"
  ],
  "author": "Stefan Popov <stefan@desourcelabs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/phone-mask.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/DeSource-Labs/phone-mask/issues"
  },
  "homepage": "https://github.com/DeSource-Labs/phone-mask/tree/main/packages/vue#readme",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./assets/lib.css": "./dist/phone-mask-vue.css"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/types",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo test-results coverage",
    "clean:modules": "rimraf node_modules",
    "dev": "vite demo",
    "build": "pnpm clean && pnpm build:internal",
    "build:internal": "pnpm build:lib && pnpm build:types && pnpm build:css",
    "build:lib": "vite build",
    "build:types": "vue-tsc -p tsconfig.json && node ../../scripts/build-dual-types.mts index core",
    "build:css": "sass src/style.scss dist/phone-mask-vue.css --no-source-map --style=compressed",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test",
    "publish:check": "node ../../scripts/check-package.mts"
  },
  "peerDependencies": {
    "vue": "^3.4.33"
  },
  "dependencies": {
    "@desource/phone-mask": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "vue": "^3.5.43",
    "vue-min": "npm:@vue/runtime-dom@3.4.33",
    "vue-tsc": "^3.3.12"
  }
}
