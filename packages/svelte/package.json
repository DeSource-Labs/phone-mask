{
  "name": "@desource/phone-mask-svelte",
  "version": "2.0.0",
  "description": "🌍 Svelte 5 component, composable, action, and attachment for international phone number masking. Powered by @desource/phone-mask with Google libphonenumber sync.",
  "keywords": [
    "svelte",
    "svelte5",
    "ssr",
    "phone",
    "mask",
    "input",
    "component",
    "international",
    "libphonenumber",
    "country-code",
    "phone-number",
    "formatting",
    "validation",
    "typescript"
  ],
  "author": "Stefan Popov <stefan@desourcelabs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/phone-mask.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/DeSource-Labs/phone-mask/issues"
  },
  "homepage": "https://github.com/DeSource-Labs/phone-mask/tree/main/packages/svelte#readme",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./assets/lib.css": "./dist/phone-mask-svelte.css"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/style.scss",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist .svelte-kit tsconfig.tsbuildinfo test-results coverage",
    "clean:modules": "rimraf node_modules",
    "dev": "vite demo",
    "build": "pnpm clean && pnpm build:internal",
    "build:internal": "pnpm build:lib && pnpm build:css",
    "build:lib": "svelte-package -i src",
    "build:css": "sass src/style.scss dist/phone-mask-svelte.css --no-source-map --style=compressed",
    "typecheck": "svelte-check --tsconfig tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test",
    "publish:check": "node ../../scripts/check-package.mts --profile esm-only"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@desource/phone-mask": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7"
  }
}
