{
  "name": "@desource/phone-mask-angular",
  "version": "1.7.0",
  "description": "Signal-based Angular phone input, directive and formatting pipe with SSR support.",
  "type": "module",
  "exports": {
    "./assets/lib.css": "./phone-mask-angular.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "angular",
    "signals",
    "zoneless",
    "phone",
    "mask",
    "input",
    "international",
    "libphonenumber",
    "ssr",
    "formatting",
    "validation",
    "typescript"
  ],
  "author": "Stefan Popov <stefan@desourcelabs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/phone-mask.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/DeSource-Labs/phone-mask/issues"
  },
  "homepage": "https://github.com/DeSource-Labs/phone-mask/tree/main/packages/angular#readme",
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": false
  },
  "scripts": {
    "clean": "rimraf dist .demo-dist .angular tsconfig.tsbuildinfo coverage test-results",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:internal",
    "build:internal": "ng build phone-mask && node scripts/build-types.mts && pnpm build:css",
    "build:css": "sass src/style.scss dist/phone-mask-angular.css --no-source-map --style=compressed",
    "build:demo": "ng build demo",
    "dev": "ng serve demo --host 127.0.0.1 --port 5173",
    "typecheck": "ngc -p tsconfig.json --noEmit && ngc -p tests/tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test",
    "test:compat": "node tests/compatibility/check.mts",
    "publish:check": "node ../../scripts/check-package.mts --profile esm-only"
  },
  "peerDependencies": {
    "@angular/common": "^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/forms": "^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "@desource/phone-mask": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@angular/animations": "19.2.25",
    "@angular/build": "19.2.27",
    "@angular/cli": "19.2.27",
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/compiler-cli": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@angular/platform-server": "19.2.25",
    "@angular/router": "19.2.25",
    "@angular/ssr": "19.2.27",
    "@testing-library/angular": "17.4.0",
    "@testing-library/dom": "^10.4.2",
    "ng-packagr": "19.2.2",
    "rxjs": "^7.8.2",
    "typescript": "5.8.3"
  }
}
