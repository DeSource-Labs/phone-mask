{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --stream run build",
    "clean": "pnpm -r --filter \"*\" --stream run clean",
    "clean:modules": "pnpm -r --filter \"*\" --stream run clean:modules && rimraf node_modules",
    "dev:demo": "pnpm --filter demo dev",
    "dev:prepare": "pnpm --filter demo prepare:deps",
    "build:demo": "pnpm --filter demo build",
    "vercel-build": "pnpm build && pnpm dev:prepare && pnpm build:demo",
    "gen": "pnpm --filter phone-mask gen",
    "changeset": "changeset",
    "changeset:format-changelogs": "node scripts/format-changelog-dependencies.mts",
    "changeset:mask-sync": "node scripts/create-mask-sync-changeset.mts",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish --no-git-tag",
    "readme:benchmarks": "node scripts/update-readme-benchmarks.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{svelte,vue,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,md}\"",
    "format:check": "prettier --check \"**/*.{svelte,vue,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,md}\"",
    "lint:staged": "lint-staged",
    "typecheck": "pnpm -r --filter \"./packages/**\" --stream run typecheck",
    "test:e2e": "pnpm -r --filter \"./packages/**\" --stream --workspace-concurrency=1 run test:e2e",
    "test:unit": "pnpm -r --filter \"./packages/**\" --stream run test:unit",
    "test:unit:coverage": "pnpm -r --filter \"./packages/**\" --stream run test:unit:coverage",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.0",
    "@rspack/core": "^2.1.7",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "css-loader": "^7.1.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-svelte": "^3.22.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.9.3",
    "vite": "~8.0.16",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{svelte,vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
