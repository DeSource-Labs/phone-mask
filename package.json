{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --stream run build",
    "clean": "pnpm -r --filter \"*\" --stream run clean",
    "clean:modules": "pnpm -r --filter \"*\" --stream run clean:modules && rimraf node_modules",
    "dev:demo": "pnpm --filter demo dev",
    "dev:prepare": "pnpm --filter demo prepare:deps",
    "build:demo": "pnpm --filter demo build",
    "vercel-build": "pnpm build && pnpm dev:prepare && pnpm build:demo",
    "gen": "pnpm --filter phone-mask gen",
    "check:peers": "pnpm peers check",
    "audit:prod": "pnpm audit --prod",
    "changeset": "changeset",
    "changeset:format-changelogs": "node scripts/format-changelog-dependencies.mts",
    "changeset:mask-sync": "node scripts/create-mask-sync-changeset.mts",
    "changeset:version": "changeset version && pnpm changeset:format-changelogs",
    "changeset:publish": "pnpm build && pnpm publish:check && changeset publish --no-git-tag",
    "publish:check": "pnpm -r --filter \"./packages/**\" --stream run publish:check",
    "check:release": "pnpm format:check && pnpm lint && pnpm check:peers && pnpm audit:prod && pnpm build && pnpm typecheck && pnpm publish:check && pnpm test:unit:coverage && pnpm test:e2e",
    "comparison:update": "node scripts/update-comparison.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{svelte,vue,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,md}\"",
    "format:check": "prettier --check \"**/*.{svelte,vue,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,md}\"",
    "lint:staged": "lint-staged",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "typecheck": "pnpm typecheck:scripts && pnpm -r --if-present --stream run typecheck",
    "test:e2e": "pnpm -r --filter \"./packages/**\" --stream --workspace-concurrency=1 run test:e2e",
    "test:unit": "pnpm -r --filter \"./packages/**\" --stream run test:unit",
    "test:unit:coverage": "pnpm -r --filter \"./packages/**\" --stream run test:unit:coverage",
    "prepare": "husky",
    "prebuild": "pnpm -r --filter \"./packages/**\" --if-present --stream run dev:prepare"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rspack/core": "^2.3.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "css-loader": "^7.1.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.16",
    "rolldown-plugin-dts": "^0.29.0",
    "sass": "^1.107.0",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{svelte,vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
